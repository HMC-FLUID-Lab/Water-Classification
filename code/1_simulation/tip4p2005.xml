<ForceField>
 <!--
   TIP4P/2005 (Abascal & Vega, JCP 2005) as an OpenMM ForceField template.
   Regenerated 2026-07 to match the residue/atom naming produced by
   molecules.py::createWater('tip4p2005') + CreateTopo.py:
       residue 'HOH', atoms O, H1, H2, M(virtual), bonds O-H1, O-H2.
   Parameters (charges, LJ, M-site 3-particle-average weights) were extracted
   at full precision from the original system_tip4p2005_*.xml so that new
   replicas reproduce Run01/Run02 exactly. Rigid geometry (rOH=0.09572 nm,
   angle=104.52 deg) is identical to TIP4P-Ew; bond/angle force constants are
   only used to build the HAngles constraints, so their exact value is inert.
 -->
 <AtomTypes>
  <Type name="tip4p2005-O" class="OW" element="O" mass="15.99943"/>
  <Type name="tip4p2005-H" class="HW" element="H" mass="1.007947"/>
  <Type name="tip4p2005-M" class="MW" mass="0"/>
 </AtomTypes>
 <Residues>
  <Residue name="HOH">
   <Atom name="O"  type="tip4p2005-O"/>
   <Atom name="H1" type="tip4p2005-H"/>
   <Atom name="H2" type="tip4p2005-H"/>
   <Atom name="M"  type="tip4p2005-M"/>
   <VirtualSite type="average3" index="3" atom1="0" atom2="1" atom3="2"
                weight1="0.736124462" weight2="0.131937762" weight3="0.131937762"/>
   <Bond atomName1="O" atomName2="H1"/>
   <Bond atomName1="O" atomName2="H2"/>
  </Residue>
 </Residues>
 <HarmonicBondForce>
  <Bond class1="OW" class2="HW" length="0.09572" k="462750.4"/>
 </HarmonicBondForce>
 <HarmonicAngleForce>
  <Angle class1="HW" class2="OW" class3="HW" angle="1.82421813418" k="836.8"/>
 </HarmonicAngleForce>
 <NonbondedForce coulomb14scale="0.833333" lj14scale="0.5">
  <Atom type="tip4p2005-O" charge="0.0"     sigma="0.31589" epsilon="0.77489"/>
  <Atom type="tip4p2005-H" charge="0.5564"  sigma="1.0"     epsilon="0.0"/>
  <Atom type="tip4p2005-M" charge="-1.1128" sigma="1.0"     epsilon="0.0"/>
 </NonbondedForce>
</ForceField>
